    void c27AuditMirrorPairs()
    {
        ++gC27PairFrames;
        for(std::uint32_t i=0;i<gDrawCount;++i)
        {
            const DrawWall& a=gDraws[i];
            if(!a.mirrorKey || (a.surfaceClass!=Surface_Lower && a.surfaceClass!=Surface_Upper)) continue;
            for(std::uint32_t j=i+1;j<gDrawCount;++j)
            {
                const DrawWall& b=gDraws[j];
                if(b.carrier.key!=a.mirrorKey || b.surfaceClass!=a.surfaceClass) continue;
                ++gC27PairMatches;
                const std::int32_t lo=a.drawX0>b.drawX0?a.drawX0:b.drawX0;
                const std::int32_t hi=a.drawX1<b.drawX1?a.drawX1:b.drawX1;
                if(lo>hi) continue;
                ++gC27PairOverlaps;
                if(a.surfaceClass==Surface_Lower) ++gC27LowerPairOverlaps; else ++gC27UpperPairOverlaps;
                if(gC27PairSampleCount<kC27PairSampleCapacity)
                    gC27PairSamples[gC27PairSampleCount++]={a.carrier.key,a.mirrorKey,a.drawX0,a.drawX1,b.drawX0,b.drawX1,(std::uint32_t)a.surfaceClass};
                else ++gC27PairSampleOverflow;
                break;
            }
        }
    }

