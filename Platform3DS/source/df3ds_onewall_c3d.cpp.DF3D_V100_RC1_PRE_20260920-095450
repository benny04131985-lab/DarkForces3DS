    struct PLStackEntry { std::uint64_t serial; std::int32_t depth; };

    constexpr std::uint32_t kPLPortalCap=128u;
    constexpr std::uint32_t kPLClipCap=768u;
    constexpr std::uint32_t kPLStackCap=32u;
    PLPortalRec gPLPortals[kPLPortalCap]{};
    PLClipRec gPLClips[kPLClipCap]{};
    PLStackEntry gPLStack[kPLStackCap]{};
    std::uint32_t gPLPortalCount=0,gPLClipCount=0,gPLStackDepth=0;
    std::uint32_t gPLPortalOverflow=0,gPLClipOverflow=0,gPLStackOverflow=0;
    std::uint64_t gPLSerial=0,gPLStartFrame=0;
    bool gPLFlushed=false;
    char gPLLogPath[256]{};

    static bool plInCaptureWindow()
    {
        return !gPLFlushed && gPLStartFrame && gFrameSerial<=gPLStartFrame+2u;
    }

    static void plRecordClip(
        const void* wallKey,std::int32_t x,std::int32_t top,std::int32_t bottom,std::uint32_t surfaceClass)
    {
        if(!plInCaptureWindow()||!wallKey||top>bottom||gPLStackDepth==0u)return;
        if(gPLClipCount>=kPLClipCap){++gPLClipOverflow;return;}
        const PLStackEntry& st=gPLStack[gPLStackDepth-1u];
        gPLClips[gPLClipCount++]={gFrameSerial,st.serial,wallKey,surfaceClass,st.depth,x,top,bottom};
    }

    static void plFlush(const char* why)
    {
        if(gPLFlushed||!gPLStartFrame)return;
        gPLFlushed=true;
        std::snprintf(gPLLogPath,sizeof(gPLLogPath),
            "sdmc:/3ds/DarkForces3DS/logs/DF3D_C3D53_PORTALLINE1_V1_%llu.log",
            (unsigned long long)osGetTime());
        FILE* f=std::fopen(gPLLogPath,"w");
        if(!f)return;
        std::fprintf(f,
            "DF3D C3D53 PORTALLINE1 V1\nwhy=%s startFrame=%llu portalCount=%lu clipCount=%lu "
            "portalOverflow=%lu clipOverflow=%lu stackOverflow=%lu\n",
            why?why:"?",
            (unsigned long long)gPLStartFrame,
            (unsigned long)gPLPortalCount,(unsigned long)gPLClipCount,
            (unsigned long)gPLPortalOverflow,(unsigned long)gPLClipOverflow,
            (unsigned long)gPLStackOverflow);
        for(std::uint32_t i=0;i<gPLPortalCount;++i)
        {
            const PLPortalRec& r=gPLPortals[i];
            std::fprintf(f,
                "P frame=%llu serial=%llu depth=%ld portal=%p cur=%p next=%p "
                "childX=%ld..%ld childY=%ld..%ld wallX=%ld..%ld z=%ld..%ld "
                "curH=%ld..%ld nextH=%ld..%ld curFlags=0x%08lx nextFlags=0x%08lx\n",
                (unsigned long long)r.frame,(unsigned long long)r.serial,(long)r.depth,
                r.portalWall,r.curSector,r.nextSector,
                (long)r.childX0,(long)r.childX1,(long)r.childMinY,(long)r.childMaxY,
                (long)r.wallX0,(long)r.wallX1,(long)r.z0,(long)r.z1,
                (long)r.curCeil,(long)r.curFloor,(long)r.nextCeil,(long)r.nextFloor,
                (unsigned long)r.curFlags,(unsigned long)r.nextFlags);
        }
        for(std::uint32_t i=0;i<gPLClipCount;++i)
        {
            const PLClipRec& r=gPLClips[i];
            std::fprintf(f,
                "C frame=%llu portalSerial=%llu depth=%ld wall=%p cls=%lu x=%ld y=%ld..%ld\n",
                (unsigned long long)r.frame,(unsigned long long)r.portalSerial,
                (long)r.depth,r.wallKey,(unsigned long)r.surfaceClass,
                (long)r.x,(long)r.top,(long)r.bottom);
        }
        std::fclose(f);
    }

