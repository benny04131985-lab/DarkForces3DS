void portalLineEnter(
    const void* portalWall,const void* curSector,const void* nextSector,
    std::int32_t depth,std::int32_t childX0,std::int32_t childX1,
    std::int32_t childMinY,std::int32_t childMaxY,
    std::int32_t wallX0,std::int32_t wallX1,
    std::int32_t z0,std::int32_t z1,
    std::int32_t curFloor,std::int32_t curCeil,
    std::int32_t nextFloor,std::int32_t nextCeil,
    std::uint32_t curFlags,std::uint32_t nextFlags)
{
    if(gPLFlushed)return;
    if(!gPLStartFrame)gPLStartFrame=gFrameSerial;
    const std::uint64_t serial=++gPLSerial;

    if(gPLStackDepth<kPLStackCap)
        gPLStack[gPLStackDepth++]={serial,depth};
    else
        ++gPLStackOverflow;

    if(!plInCaptureWindow())return;
    if(gPLPortalCount>=kPLPortalCap){++gPLPortalOverflow;return;}
    gPLPortals[gPLPortalCount++]={
        gFrameSerial,serial,portalWall,curSector,nextSector,
        depth,childX0,childX1,childMinY,childMaxY,
        wallX0,wallX1,z0,z1,
        curFloor,curCeil,nextFloor,nextCeil,curFlags,nextFlags
    };
}

void portalLineLeave()
{
    if(gPLFlushed)return;
    if(gPLStackDepth) --gPLStackDepth;
}


