void auditMaskRoute(const void* wallKey,const void* textureKey,const void* nextSectorKey,
    std::int32_t drawFlags,std::int32_t drawX0,std::int32_t drawX1,
    std::int32_t sectorExterior,std::int32_t nextExtAdj,std::int32_t nextExtFloorAdj,
    std::int32_t adjMidTex,std::int32_t stage)
{
    if(!wallKey)return;
    if(stage==0)
    {
        otAddClassicOverlay(wallKey,textureKey,nullptr,OT_MASK,0u,drawFlags,drawX0,drawX1);
        if(otIsTarget(wallKey))
        {
            const std::uint32_t packed=(sectorExterior?1u:0u)|(nextExtAdj?2u:0u)|(nextExtFloorAdj?4u:0u)|(adjMidTex?8u:0u);
            otMarkTarget(OT_MASK,textureKey,nullptr,packed,drawFlags,drawX0,drawX1);
        }
    }
    if(stage==0)
    {
        ++gC22MaskDispatchCalls;
        if(drawFlags==0)++gC22MaskDrawFlagsZero;
        if(nextExtAdj)++gC22MaskExtAdjCalls;
        if(nextExtFloorAdj)++gC22MaskExtFloorCalls;
        if(nextExtAdj&&nextExtFloorAdj)++gC22MaskBothExtCalls;
        if(adjMidTex)++gC22MaskMidTexCalls;
    }
    else if(stage==1)
    {
        ++gC22TransparentSuppressed;
    }
    for(std::uint32_t i=0;i<gC22MaskRouteSampleCount;++i)
    {
        C22MaskRouteSample& s=gC22MaskRouteSamples[i];
        if(s.wallKey==wallKey&&s.textureKey==textureKey&&s.nextSectorKey==nextSectorKey&&s.drawFlags==drawFlags&&s.stage==stage&&
           s.sectorExterior==sectorExterior&&s.nextExtAdj==nextExtAdj&&s.nextExtFloorAdj==nextExtFloorAdj&&s.adjMidTex==adjMidTex)
        {++s.calls;s.drawX0=drawX0;s.drawX1=drawX1;return;}
    }
    if(gC22MaskRouteSampleCount>=kC22MaskRouteSampleCapacity){++gC22MaskRouteSampleOverflow;return;}
    C22MaskRouteSample& s=gC22MaskRouteSamples[gC22MaskRouteSampleCount++];
    s={wallKey,textureKey,nextSectorKey,drawFlags,drawX0,drawX1,sectorExterior,nextExtAdj,nextExtFloorAdj,adjMidTex,stage,1u};
}

